# Kopieren nach infra/.env und ausfüllen. infra/.env wird NIE eingecheckt (ADR-0009).
GITHUB_OWNER=krauspeter
# Kanal für Images und automatisches Deployment (AP-3): main = jeder Merge (Beta), latest = letzte
# Release-Version (ab v1.0), oder eine feste Version wie 1.0.0
TOPSTACK_VERSION=main
TOPSTACK_ENVIRONMENT=prod
TOPSTACK_PUBLIC_ORIGIN=https://topstack.win
POSTGRES_PASSWORD=bitte-ein-langes-zufallspasswort
# Token aus Cloudflare: Networking -> Tunnels -> topstack -> Docker, nur der Teil nach --token
CF_TUNNEL_TOKEN=token-aus-dem-cloudflare-dashboard
# Resend: API Keys -> topstack-heimserver (Sending access). Leer = Anmeldelinks nur im Log der API
RESEND_API_KEY=
# Web Push (AP-8): auf dem Heimserver erzeugen mit
#   docker compose exec -T api python -m topstack.scripts.vapid_keys >> .env
# und beide Zeilen hier einsetzen. Leer = keine Push-Nachrichten.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Backups (Phase 4, AP-1). Anleitung: docs/phase3/heimserver.md, Abschnitt „Backups einrichten“.
# Ordner auf dem Heimserver, absolut und außerhalb des Repos, z. B. /home/peter/topstack-backups
BACKUP_DIR=
# Besitzer der Backup-Dateien auf dem Heimserver: Ausgabe von `id -u` und `id -g`
BACKUP_UID=1000
BACKUP_GID=1000
# on = verschlüsselte Kopie nach Cloudflare R2, off = nur lokal
BACKUP_OFFSITE=on
# Öffentlicher age-Schlüssel (beginnt mit age1). Der private Schlüssel gehört NUR in den Passwort-Manager.
BACKUP_AGE_RECIPIENT=
# Cloudflare R2: Bucket mit Speicherort EU, Endpoint https://<Account-ID>.eu.r2.cloudflarestorage.com
R2_BUCKET=topstack-backups
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# healthchecks.io (AP-2), leer = kein Ping
BACKUP_PING_URL=
RESTORE_TEST_PING_URL=

# ntfy (AP-2/AP-3): Meldungen des automatischen Deployments, z. B. https://ntfy.sh/topstack-<zufall>
NTFY_URL=
