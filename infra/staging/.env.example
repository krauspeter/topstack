# Staging beta.topstack.win (AP-3b). Im zweiten Klon auf dem Heimserver nach
# ~/topstack-beta/infra/.env kopieren und ausfüllen. Wird NIE eingecheckt (ADR-0009).
# Anleitung: docs/phase3/heimserver.md, Abschnitt „Staging beta.topstack.win“.
TOPSTACK_STACK=staging
GITHUB_OWNER=krauspeter
# main = jeder Merge; pr-<Nummer> = Stand eines Pull Requests, gesetzt mit scripts/stage.sh am PC.
# Nach Merge oder Schließen des PRs stellt deploy.sh selbst wieder auf main.
TOPSTACK_VERSION=main
TOPSTACK_PUBLIC_ORIGIN=https://beta.topstack.win
# Eigenes Passwort, nicht das der Produktion
POSTGRES_PASSWORD=bitte-ein-anderes-langes-zufallspasswort
# Resend wie in der Produktion; leer = Anmeldelinks nur im Log (docker compose … logs api)
RESEND_API_KEY=
# Pflicht: nur an diese Adressen gehen Anmeldelinks wirklich raus, kommagetrennt
MAIL_ALLOWLIST=deine-adresse@example.com
# ntfy wie in der Produktion; Meldungen heißen hier „TopStack Beta: …“
NTFY_URL=
# Feedback geht auf Staging nicht an GitHub (kein FEEDBACK_GITHUB_TOKEN); ansehen mit
# python -m topstack.scripts.feedback list im Staging-Stack
