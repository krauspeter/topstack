# TLS übernimmt Cloudflare; Caddy spricht intern HTTP.
:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /ws {
		reverse_proxy api:8000
	}
	handle {
		root * /srv/app
		# Dateien mit Hash im Namen dürfen ewig im Cache bleiben,
		# alles andere (index.html, sw.js, Manifest) wird immer neu geprüft.
		@hashed path /assets/*
		@other not path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header @other Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
